{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/components/airport",
    "src/components/layout",
    "src/components/canvas/alert-system.tsx",
    "src/components/canvas/building-exterior.tsx",
    "src/components/canvas/cargo-building-7.tsx",
    "src/components/canvas/cargo-building-8.tsx",
    "src/components/canvas/cargo-gate.tsx",
    "src/components/canvas/cargo-pallet.tsx",
    "src/components/canvas/clickable-truck.tsx",
    "src/components/canvas/conveyor-belt.tsx",
    "src/components/canvas/exterior-elements.tsx",
    "src/components/canvas/first-person-controller.tsx",
    "src/components/canvas/floating-label.tsx",
    "src/components/canvas/forklift.tsx",
    "src/components/canvas/interior-zones.tsx",
    "src/components/canvas/keyboard-controls.tsx",
    "src/components/canvas/loading-dock.tsx",
    "src/components/canvas/metal-shelving.tsx",
    "src/components/canvas/problem-alert.tsx",
    "src/components/canvas/road-network.tsx",
    "src/components/canvas/road-segment.tsx",
    "src/components/canvas/roofed-warehouse.tsx",
    "src/components/canvas/sakura-tree.tsx",
    "src/components/canvas/sign-label.tsx",
    "src/components/canvas/simulated-trucks.tsx",
    "src/components/canvas/simulated-uld-trolleys.tsx",
    "src/components/canvas/traffic-arrow.tsx",
    "src/components/canvas/truck-yard.tsx",
    "src/components/canvas/truck.tsx",
